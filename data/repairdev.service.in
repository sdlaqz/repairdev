#  This file is part of repairdev.
#

[Unit]
Description=Repair special hardware for Linux
Documentation=man:repairdev.service(8)
DefaultDependencies=no
#ConditionPathIsReadWrite=!/
#Conflicts=shutdown.target
ConditionPathIsReadWrite=/etc
Before=firstboot.service graphical.target
After=systemd-remount-fs.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=@BIN_DIR@/check7200.sh
TimeoutSec=0

[Install]
WantedBy=multi-user.target
